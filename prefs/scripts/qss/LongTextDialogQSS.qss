
RoundedCornerLongTextDialog {
                border-radius: 10px;
                background-color: #f0f0f0;
            }

QTextEdit {
                border: none;
                font-family: "YouYuan"; 
                font-size: 23px; 
                border-radius: 10px; 
                background-color: rgb(35,35,35); 
            }

QPushButton {
                border-radius: 5px;
                font-family: "YouYuan"; 
                font-size: 20px; 
                background-color: rgb(200,103,180);
                color: white;
                text-align: center;
                padding: 10px;
                transition: background-color 0.3s ease-in-out;
            }
QPushButton:hover {
                background-color: rgb(250,107,180); /* 高亮颜色 */
            }
QPushButton:pressed {
                background-color: rgb(50,50,50);
            }